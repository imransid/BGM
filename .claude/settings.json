{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeGitInstructions": false,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(pnpm run *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm build *)",
      "Bash(pnpm verify *)",
      "Bash(pnpm exec *)",
      "Bash(pnpm install --frozen-lockfile *)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go run *)",
      "Bash(golangci-lint *)",
      "Bash(govulncheck *)",
      "Bash(make -C services/engines *)",
      "Bash(docker compose *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git fetch *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(pnpm add *)",
      "Bash(pnpm update *)",
      "Bash(go get *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(**/.env)",
      "Bash(git config *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "onFailure": "block",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs\""
          }
        ]
      }
    ]
  }
}
